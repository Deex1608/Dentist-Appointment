<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.laborator5.GUI.DisplayGroupedController"
            prefHeight="450.0" prefWidth="700.0">

    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
    </padding>

    <Label text="Grouped Results" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" style="-fx-font-weight: bold; -fx-font-size: 16px;" />

    <Accordion fx:id="groupAccordion"
               AnchorPane.topAnchor="40.0"
               AnchorPane.bottomAnchor="50.0"
               AnchorPane.leftAnchor="10.0"
               AnchorPane.rightAnchor="10.0" />

</AnchorPane>