<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.geometry.Insets?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.laborator5.GUI.DisplayController"
            prefHeight="400.0" prefWidth="600.0">

        <padding>
            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
        </padding>

        <Label text="Patient Results" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" style="-fx-font-weight: bold; -fx-font-size: 16px;" />

        <TableView fx:id="patientTableView" AnchorPane.topAnchor="40.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <columns>
                <TableColumn fx:id="patientIdColumn" text="ID" prefWidth="50">
                    <cellValueFactory>
                        <PropertyValueFactory property="Id" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="patientNameColumn" text="Name" prefWidth="150">
                    <cellValueFactory>
                        <PropertyValueFactory property="Name" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="patientPhoneColumn" text="Phone Number" prefWidth="120">
                    <cellValueFactory>
                        <PropertyValueFactory property="Telephone" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="patientEmailColumn" text="Email" prefWidth="180">
                    <cellValueFactory>
                        <PropertyValueFactory property="Email" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="patientProblemColumn" text="Problem" prefWidth="120">
                    <cellValueFactory>
                        <PropertyValueFactory property="Problem" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>



</AnchorPane>
