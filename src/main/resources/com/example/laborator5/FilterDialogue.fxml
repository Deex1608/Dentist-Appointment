<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.laborator5.GUI.FilterController"
            prefHeight="400.0" prefWidth="600.0">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <GridPane layoutX="10.0" layoutY="10.0" prefWidth="380.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" vgap="15" hgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
        </columnConstraints>

        <Label text="Select Criterion:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="filterCriterionComboBox" prefWidth="250.0"
                  promptText="Choose a filter..."
                  onAction="#handleCriterionSelection"
                  GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label fx:id="valueLabel" text="Enter Primary Value:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
        <TextField fx:id="filterValueField" promptText="Name / Problem / Date / Email Domain"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label fx:id="secondaryValueLabel" text="Enter Secondary Value:"
               GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"
               visible="false"/>
        <TextField fx:id="secondaryValueField" promptText="Enter Email Domain (e.g., @yahoo.com)"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"
                   visible="false"/>
    </GridPane>

    <HBox spacing="10.0" alignment="CENTER_RIGHT" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0">
        <Button text="Apply Filter" onAction="#handleApplyFilter" defaultButton="true" />
        <Button text="Cancel" onAction="#handleCancel" cancelButton="true" />
    </HBox>

</AnchorPane>
